{
  "name": "game-studio-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Type-safe static editorial web platform for an independent game studio",
  "license": "Apache-2.0",
  "scripts": {
    "sync-credits": "node scripts/render-credits.js",
    "add-member": "node scripts/add-credit.js",
    "build": "node scripts/render-credits.js && tsc && node scripts/bundle.js",
    "typecheck": "node scripts/render-credits.js && tsc --noEmit",
    "watch": "tsc --watch"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
